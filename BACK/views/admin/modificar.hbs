<div class="container" style="margin:100px auto">
    <div class="row">
        <div class="col-6 offset-3">
            <h4>Modificar novedad</h4>
            <form action="/admin/novedades/modificar" method="post">
                <input type="hidden" value="{{novedad.idNovedades}}" name="idNovedades">

                <div class="mb-3 row">
                    <label class="form-label fw-bold">Título</label>
                    <input type="text" class="form-control" placeholder="Título" name="titulo" value="{{novedad.titulo}}">
                </div>
                
                <div class="mb-3 row">
                    <label class="form-label fw-bold">Género</label>
                    <input type="text" class="form-control" placeholder="Género" name="genero" value="{{novedad.genero}}">
                </div>
                
                <div class="mb-3 row">
                    <label class="form-label fw-bold">Teatro</label>
                    <textarea class="form-control" placeholder="Teatro" name="teatro">{{novedad.teatro}}</textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a href="/admin/novedades" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>

            {{#if error}}
                <p class="text-danger mt-3">{{message}}</p>
            {{/if}}
        </div>
    </div>
</div>