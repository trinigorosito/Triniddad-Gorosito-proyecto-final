<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>

    <header class="navbar navbar-expand-lg navbar-dark navbar-custom px-3 py-2 shadow-sm mb-4">
      <div class="container-fluid px-lg-4">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/admin/novedades">
          <i class="fa-solid fa-masks-theater text-warning fs-4"></i>
          <span>Panel Admin</span>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar" aria-controls="adminNavbar" aria-expanded="false" aria-label="Menu">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-lg-1">
            <li class="nav-item">
              <a class="nav-link px-3" href="/admin/novedades">
                <i class="fa-regular fa-newspaper me-1"></i> Novedades
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link px-3" href="/admin/obras">
                <i class="fa-solid fa-ticket me-1"></i> Obras
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link px-3" href="/admin/contacto">
                <i class="fa-regular fa-envelope me-1"></i> Contacto
              </a>
            </li>
          </ul>

          <div class="d-flex align-items-center gap-3">
            <span class="text-light small">
              <i class="fa-solid fa-user-check text-info me-1"></i> Hola, <strong>{{usuario}}</strong>
            </span>
            <a class="btn btn-sm btn-outline-danger px-3 rounded-pill" href="/admin/login/logout">
              Salir <i class="fa-solid fa-right-from-bracket ms-1"></i>
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="pb-5">
      {{{body}}}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>